# Copy this file to .env and fill in real values. Never commit .env.

# Port the server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API.
# For local testing with the file opened directly in a browser, "*" is fine.
# Once the site is deployed, replace with the real domain(s), e.g.
# CORS_ORIGIN=https://oldstoneeducation.com,https://www.oldstoneeducation.com
CORS_ORIGIN=*

# --- Email (SMTP) settings ---
# Works with Gmail if you create an "App Password" (not your normal password):
# Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=oldstoneform@gmail.com
SMTP_PASS=xoprmsgobpulgvpzyour

# Where the submitted enquiries should be delivered.
# Can be the same as SMTP_USER, or a different inbox.
NOTIFY_TO=oldstoneform@gmail.com
